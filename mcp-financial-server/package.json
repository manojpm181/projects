{

  "name": "mcp-financial-server",

  "version": "1.0.0",

  "description": "Advanced MCP Server for Financial Data",

  "main": "dist/index.js",

  "type": "module",

  "scripts": {

    "build": "tsc && tsc-alias",

    "start": "node dist/index.js",

    "start:sse": "node dist/index.js sse",

    "start:prod": "cross-env NODE_ENV=production node dist/index.js",

    "dev": "tsx watch src/index.ts",

    "dev:sse": "tsx watch src/index.ts sse",

    "seed": "tsx database/seed.ts",

    "test": "vitest run",

    "lint": "eslint src --ext .ts",

    "format": "prettier --write src/**/*.ts"

  },

  "engines": {

    "node": ">=18.0.0"

  },

  "dependencies": {

    "@modelcontextprotocol/sdk": "^0.6.0",

    "@supabase/supabase-js": "^2.39.0",

    "cross-env": "^10.1.0",

    "date-fns": "^3.0.6",

    "dotenv": "^16.3.1",

    "pino": "^8.17.1",

    "pino-pretty": "^10.3.1",

    "tsconfig-paths": "^4.2.0",

    "ulid": "^2.3.0",

    "zod": "^3.22.4"

  },

  "devDependencies": {

    "@faker-js/faker": "^8.3.1",

    "@types/node": "^20.10.0",

    "@typescript-eslint/eslint-plugin": "^6.13.0",

    "@typescript-eslint/parser": "^6.13.0",

    "eslint": "^8.55.0",

    "prettier": "^3.1.0",

    "tsc-alias": "^1.8.16",

    "tsx": "^4.7.0",

    "typescript": "^5.3.0",

    "vitest": "^1.1.0"

  }

}

